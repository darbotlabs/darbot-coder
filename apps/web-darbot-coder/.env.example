# Required secrets
# Server-side GitHub API token used to fetch repository statistics without hitting rate limits.
GITHUB_API_TOKEN=

# Optional public fallbacks (leave empty unless you explicitly need browser access)
NEXT_PUBLIC_GITHUB_TOKEN=

# PostHog analytics configuration. Leave blank to disable analytics entirely.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Basin form endpoint for the enterprise contact form (e.g. https://usebasin.com/f/your-form-id)
NEXT_PUBLIC_BASIN_ENDPOINT=
